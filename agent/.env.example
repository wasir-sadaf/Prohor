# ── LLM Provider Configuration ──────────────────────────────────
# Supported providers: "openai", "google", "mock"
LLM_PROVIDER=openai

# OpenAI settings
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_API_KEY
OPENAI_MODEL=gpt-6-luna

# Google / Gemini settings (only when LLM_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# Generation parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30

# ── Backend RAG Integration ──────────────────────────────────────
# Set PROHOR_BACKEND_URL to use the real backend legal search API.
# Leave unset to use the mock RAG client for local development.
# PROHOR_BACKEND_URL=http://localhost:5000
# PROHOR_BACKEND_TOKEN=your_jwt_token_here
